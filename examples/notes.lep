# Notes — a fully editable text area, declared as an ordinary `textedit` control
# (Phase 13: no more separate `text window` mode, and `page` is just a name we
# chose — it isn't reserved). Type in the page; closing the window saves what
# you wrote to notes.txt.

window "Notes", 600, 400:

    textedit as page at 0, 20, 600, 380
    label "" as wordCountLabel at 0, 0, 200, 20

    page.text = "Start typing..."

    on change page:
        wordCountLabel.text = "Editing..."

    on close:
        write_file("notes.txt", page.text)
