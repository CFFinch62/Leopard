# Turtle graphics — pen state, movement, and shapes. `graphics` is a control now
# (Phase 13), placed like any other, and its commands are dotted method calls.

window "Turtle Demo", 640, 480:
    graphics as canvas1 at 0, 0, 640, 480
    canvas1.pen("red")
    canvas1.size(3)
    canvas1.down()
    canvas1.go(100)
    canvas1.turn(90)
    canvas1.go(100)
    canvas1.up()
    canvas1.goto(300, 300)
    canvas1.fill("blue")
    canvas1.circlefilled(40)
