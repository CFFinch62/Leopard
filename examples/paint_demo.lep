# A `graphics` control, a `textedit` control, and ordinary buttons, all coexisting
# in one window (Phase 13). This is the whole point of turtle graphics and text
# areas being controls instead of exclusive window kinds: a real app — here, a tiny
# paint program — can combine a drawing surface, a log area, and controls together.

window "Paint Demo", 500, 420:

    graphics as canvas1 at 0, 0, 500, 250
    textedit as logBox at 0, 250, 500, 130
    button "Draw circle" as btnCircle at 0, 380, 120, 30
    button "Draw square" as btnSquare at 130, 380, 120, 30
    button "Clear" as btnClear at 260, 380, 100, 30

    canvas1.backcolor("white")
    logBox.text = "Ready.\n"

    on click btnCircle:
        canvas1.pen("red")
        canvas1.fill("red")
        canvas1.place(250, 125)
        canvas1.circlefilled(40)
        logBox.text = logBox.text & "Drew a circle.\n"

    on click btnSquare:
        canvas1.pen("blue")
        canvas1.fill("blue")
        canvas1.place(100, 60)
        canvas1.boxfilled(60, 60)
        logBox.text = logBox.text & "Drew a square.\n"

    on click btnClear:
        canvas1.backcolor("white")
        logBox.text = logBox.text & "Cleared.\n"
