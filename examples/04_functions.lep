# Lesson 04 - Functions
#
# One keyword covers both "functions" (return a value) and "procedures"
# (just do something) - if you never `return`, calling it is just running
# a named block of code.

function square(n):
    return n * n

function greeting(who):
    return "Hello, " & who & "!"

function factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n - 1)

print "square(6) = " & str(square(6))
print greeting("Chuck")
print "factorial(5) = " & str(factorial(5))

# Assigning to a variable inside a function always creates a LOCAL variable,
# even if a same-named variable exists outside - so a function can't build
# up an outer variable just by assigning to it. A function's side effects
# have to go through something other than plain assignment - here, print -
# to actually be visible outside it.
outer_value = "outside"

function shadow_demo():
    outer_value = "inside"
    print "inside shadow_demo, outer_value is: " & outer_value
    return outer_value

print "shadow_demo() returned: " & shadow_demo()
print "outer_value is still: " & outer_value
