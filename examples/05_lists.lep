# Lesson 05 - Lists
#
# Lists are 1-based (fruits[1] is the first element), grow with .add(), and
# report their size with .length. There's no built-in way to remove an item
# or reassign list[i] = value directly - see the "rebuild the list" pattern
# below, which is how Leopard programs handle both.

fruits = ["apple", "banana", "cherry"]
log = ""

log = log & "fruits.length: " & str(fruits.length) & "\n"
log = log & "fruits[1]: " & fruits[1] & "\n"
log = log & "fruits[fruits.length]: " & fruits[fruits.length] & "\n"

fruits.add("date")
log = log & "after .add(\"date\"), length: " & str(fruits.length) & "\n"

# Iterate a list with a for loop over its indices.
all_fruits = ""
for i = 1 to fruits.length:
    all_fruits = all_fruits & fruits[i] & " "
log = log & "all fruits: " & all_fruits & "\n"

# Building up a new list from scratch, e.g. filtering out "banana": Leopard
# lists can't have an item removed or replaced in place, so the normal
# pattern is to build a fresh list with .add() and then reassign the
# variable to point at it.
without_banana = []
for i = 1 to fruits.length:
    if fruits[i] <> "banana":
        without_banana.add(fruits[i])
fruits = without_banana
log = log & "after removing banana: " & str(fruits.length) & " items\n"

# A running total over a list of numbers.
scores = [10, 20, 30, 40]
total = 0
for i = 1 to scores.length:
    total = total + scores[i]
log = log & "sum of scores: " & str(total) & "\n"

write_file("05_output.txt", log)
