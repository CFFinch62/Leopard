# Lesson 01 - Variables and types
#
# `print` writes a value straight to the console - the simplest way to see
# what a bare (no-window) Leopard program computed.

age = 30
name = "Ada"
is_student = false
grades = [88, 91, 76]

print "name: " & name
print "age: " & str(age)
print "is_student: " & str(is_student)

# Lists are 1-based: grades[1] is the first element, not grades[0].
print "first grade: " & str(grades[1])
print "last grade: " & str(grades[grades.length])
print "grade count: " & str(grades.length)

# num() parses a string into a number; str() does the reverse.
parsed = num("42")
print "num(\"42\") + 1 = " & str(parsed + 1)
