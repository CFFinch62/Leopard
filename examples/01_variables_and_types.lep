# Lesson 01 - Variables and types
#
# A bare (no-window) Leopard program has no `print` builtin, so this lesson
# writes what it computes to a file instead: run it, then open
# 01_output.txt to see the results.

age = 30
name = "Ada"
is_student = false
grades = [88, 91, 76]

log = ""
log = log & "name: " & name & "\n"
log = log & "age: " & str(age) & "\n"
log = log & "is_student: " & str(is_student) & "\n"

# Lists are 1-based: grades[1] is the first element, not grades[0].
log = log & "first grade: " & str(grades[1]) & "\n"
log = log & "last grade: " & str(grades[grades.length]) & "\n"
log = log & "grade count: " & str(grades.length) & "\n"

# num() parses a string into a number; str() does the reverse.
parsed = num("42")
log = log & "num(\"42\") + 1 = " & str(parsed + 1) & "\n"

write_file("01_output.txt", log)
