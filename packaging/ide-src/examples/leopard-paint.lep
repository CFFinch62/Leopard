# A rudimentary painting program to show a GUI app using:
# 	Text, Turtle, Button, and Menu controls simultaneously
#
# Each shape button asks a short series of questions (position, size, then a
# color picker) and adds the finished shape to the canvas. Every shape drawn
# is remembered in a set of parallel lists (fg_type/fg_x/fg_y/fg_size/
# fg_color/fg_content, one slot per shape, all the same length) so Undo/Redo
# can rebuild the picture from scratch instead of touching the canvas
# directly - Leopard has no record/object type, so parallel lists are the
# normal way to keep several fields about the same items (see 05_lists.lep
# and todo_capstone.lep). The background (canvas color + grid) is separate
# from that list since only the latest choice ever matters.
#
# The status line under the canvas always shows just the most recent action.
# The full history of what's been drawn lives in the fg_* lists themselves,
# which double as "the log" - the Log menu's Save/Load/Replay write that log
# out to a text file, read one back in, and redraw the canvas from it, using
# split()/join() to turn each shape into one delimited line and back.

window "Leopard Paint", 650, 520:

## GLOBALS
    bg_color = "lightgrey"
    grid_on = false

    fg_type = []
    fg_x = []
    fg_y = []
    fg_size = []
    fg_color = []
    fg_content = []

    redo_type = []
    redo_x = []
    redo_y = []
    redo_size = []
    redo_color = []
    redo_content = []

## GUI INITIALIZATION

# Drawing area
    groupbox "CANVAS" as canvasGroup at 160, 10, 460, 420
    graphics as canvas1 at 170, 30, 460, 410
    canvas1.backcolor(bg_color)

# Drawing Toolbox
    groupbox "TOOLS" as toolsGroup at 20, 10, 140, 500

    groupbox "Background" as colorsGroup at 30, 30, 120, 110
    button "Canvas Color" as btnBG at 40, 60, 100, 30
    button "Grid: Off" as btnGrid at 40, 100, 100, 30

    groupbox "Shapes" as shapesGroup at 30, 150, 120, 190
    button "Draw Line" as btnLine at 40, 180, 100, 30
    button "Draw Circle" as btnCircle at 40, 220, 100, 30
    button "Draw Square" as btnSquare at 40, 260, 100, 30
    button "Add Text" as btnText at 40, 300, 100, 30

    groupbox "Edits" as editGroup at 30, 350, 120, 150
    button "Undo" as btnUndo at 40, 380, 100, 30
    button "Redo" as btnRedo at 40, 420, 100, 30
    button "Clear" as btnClear at 40, 460, 100, 30

# Status area (last action only - see the Log menu for the full history)
    groupbox "STATUS" as statusGroup at 170, 450, 460, 60
    textedit as status at 180, 475, 440, 25
    status.text = "Ready."

# Menu
    menu "&Log" as logMenu:
        item "&Save Picture..." as mnuSave
        item "&Load Picture..." as mnuLoad
        item "&Replay" as mnuReplay

## HELPER FUNCTIONS

    function drawShape(kind, x, y, sz, color, content):
        canvas1.pen(color)
        canvas1.fill(color)
        if kind = "line":
            canvas1.place(x, y)
            canvas1.down()
            canvas1.north()
            canvas1.go(sz)
            canvas1.up()
        elseif kind = "circle":
            canvas1.place(x, y)
            canvas1.circlefilled(sz)
        elseif kind = "square":
            canvas1.place(x, y)
            canvas1.boxfilled(sz, sz)
        elseif kind = "text":
            canvas1.font("Arial", 14)
            canvas1.place(x, y)
            canvas1.text(content)

    function drawGrid():
        canvas1.pen("gainsboro")
        canvas1.size(1)
        for gx = 0 to 460 step 50:
            canvas1.place(gx, 0)
            canvas1.down()
            canvas1.goto(gx, 410)
            canvas1.up()
        for gy = 0 to 410 step 50:
            canvas1.place(0, gy)
            canvas1.down()
            canvas1.goto(460, gy)
            canvas1.up()

    function refreshCanvas():
        canvas1.backcolor(bg_color)
        if grid_on:
            drawGrid()
        for i = 1 to fg_type.length:
            drawShape(fg_type[i], fg_x[i], fg_y[i], fg_size[i], fg_color[i], fg_content[i])

    # Asks position/size/color one question at a time (Leopard's dialogs are
    # single-purpose - notice/confirm/ask/color_dialog - there's no one
    # multi-field dialog box), then appends the shape to the fg_* lists and
    # draws it. Returns false (and adds nothing) if any step is cancelled.
    function addShape(kind):
        content = ""
        if kind = "text":
            content = ask("Text to add:")
            if content = "":
                return false

        x_text = ask("X position (0-460):")
        if x_text = "":
            return false
        y_text = ask("Y position (0-410):")
        if y_text = "":
            return false

        sz = 0
        if kind <> "text":
            sz_text = ask("Size (radius/side/length):")
            if sz_text = "":
                return false
            sz = num(sz_text)

        color = color_dialog()
        if color = "":
            return false

        x = num(x_text)
        y = num(y_text)
        fg_type.add(kind)
        fg_x.add(x)
        fg_y.add(y)
        fg_size.add(sz)
        fg_color.add(color)
        fg_content.add(content)

        drawShape(kind, x, y, sz, color, content)
        return true

    # One line per shape ("kind|x|y|size|color|content"), plus a leading
    # "background|color|grid_on" line - the whole picture as plain text.
    function buildSaveLines():
        lines = []
        lines.add(join(["background", bg_color, str(grid_on)], "|"))
        for i = 1 to fg_type.length:
            fields = [fg_type[i], str(fg_x[i]), str(fg_y[i]), str(fg_size[i]), fg_color[i], fg_content[i]]
            lines.add(join(fields, "|"))
        return lines

    # The inverse of buildSaveLines(). A function can't reassign a global
    # list (only mutate one in place - see 05_lists.lep's note on scoping),
    # so this hands its results back as one list of results for the caller
    # to unpack instead: [type, x, y, size, color, content, bg, grid].
    # Malformed lines (wrong field count) are skipped rather than crashing
    # the whole load.
    function parseSaveLines(lines):
        new_type = []
        new_x = []
        new_y = []
        new_size = []
        new_color = []
        new_content = []
        new_bg = "lightgrey"
        new_grid = false
        for i = 1 to lines.length:
            line = lines[i]
            if line <> "":
                fields = split(line, "|")
                if fields[1] = "background" and fields.length = 3:
                    new_bg = fields[2]
                    new_grid = (fields[3] = "true")
                elseif fields.length = 6:
                    new_type.add(fields[1])
                    new_x.add(num(fields[2]))
                    new_y.add(num(fields[3]))
                    new_size.add(num(fields[4]))
                    new_color.add(fields[5])
                    new_content.add(fields[6])
        return [new_type, new_x, new_y, new_size, new_color, new_content, new_bg, new_grid]

## EVENT HANDLERS

    on click btnBG:
        chosen = color_dialog()
        if chosen <> "":
            bg_color = chosen
            refreshCanvas()
            status.text = "Canvas color changed."

    on click btnGrid:
        grid_on = not grid_on
        if grid_on:
            btnGrid.text = "Grid: On"
        else:
            btnGrid.text = "Grid: Off"
        refreshCanvas()
        status.text = "Toggled grid."

    on click btnLine:
        if addShape("line"):
            status.text = "Drew a line."
        else:
            status.text = "Cancelled."

    on click btnCircle:
        if addShape("circle"):
            status.text = "Drew a circle."
        else:
            status.text = "Cancelled."

    on click btnSquare:
        if addShape("square"):
            status.text = "Drew a square."
        else:
            status.text = "Cancelled."

    on click btnText:
        if addShape("text"):
            status.text = "Added text."
        else:
            status.text = "Cancelled."

    on click btnUndo:
        n = fg_type.length
        if n = 0:
            status.text = "Nothing to undo."
        else:
            redo_type.add(fg_type[n])
            redo_x.add(fg_x[n])
            redo_y.add(fg_y[n])
            redo_size.add(fg_size[n])
            redo_color.add(fg_color[n])
            redo_content.add(fg_content[n])

            new_type = []
            new_x = []
            new_y = []
            new_size = []
            new_color = []
            new_content = []
            for i = 1 to n - 1:
                new_type.add(fg_type[i])
                new_x.add(fg_x[i])
                new_y.add(fg_y[i])
                new_size.add(fg_size[i])
                new_color.add(fg_color[i])
                new_content.add(fg_content[i])
            fg_type = new_type
            fg_x = new_x
            fg_y = new_y
            fg_size = new_size
            fg_color = new_color
            fg_content = new_content

            refreshCanvas()
            status.text = "Undid last shape."

    on click btnRedo:
        n = redo_type.length
        if n = 0:
            status.text = "Nothing to redo."
        else:
            fg_type.add(redo_type[n])
            fg_x.add(redo_x[n])
            fg_y.add(redo_y[n])
            fg_size.add(redo_size[n])
            fg_color.add(redo_color[n])
            fg_content.add(redo_content[n])

            new_type = []
            new_x = []
            new_y = []
            new_size = []
            new_color = []
            new_content = []
            for i = 1 to n - 1:
                new_type.add(redo_type[i])
                new_x.add(redo_x[i])
                new_y.add(redo_y[i])
                new_size.add(redo_size[i])
                new_color.add(redo_color[i])
                new_content.add(redo_content[i])
            redo_type = new_type
            redo_x = new_x
            redo_y = new_y
            redo_size = new_size
            redo_color = new_color
            redo_content = new_content

            refreshCanvas()
            status.text = "Redid shape."

    on click btnClear:
        fg_type = []
        fg_x = []
        fg_y = []
        fg_size = []
        fg_color = []
        fg_content = []
        redo_type = []
        redo_x = []
        redo_y = []
        redo_size = []
        redo_color = []
        redo_content = []
        bg_color = "lightgrey"
        grid_on = false
        btnGrid.text = "Grid: Off"
        refreshCanvas()
        status.text = "Cleared."

    on click mnuSave:
        path = save_file_dialog()
        if path <> "":
            write_file(path, join(buildSaveLines(), "\n"))
            status.text = "Saved picture to " & path

    on click mnuLoad:
        path = open_file_dialog()
        if path <> "":
            contents = read_file(path)
            result = parseSaveLines(split(contents, "\n"))
            fg_type = result[1]
            fg_x = result[2]
            fg_y = result[3]
            fg_size = result[4]
            fg_color = result[5]
            fg_content = result[6]
            bg_color = result[7]
            grid_on = result[8]

            redo_type = []
            redo_x = []
            redo_y = []
            redo_size = []
            redo_color = []
            redo_content = []

            if grid_on:
                btnGrid.text = "Grid: On"
            else:
                btnGrid.text = "Grid: Off"
            refreshCanvas()
            status.text = "Loaded picture from " & path

    on click mnuReplay:
        n = fg_type.length
        refreshCanvas()
        status.text = "Replayed " & str(n) & " shape(s)."
