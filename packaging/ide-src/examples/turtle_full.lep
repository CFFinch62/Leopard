# Turtle graphics, full tour - every §10 command except drawbmp (which needs
# an image file of your own; see the commented-out line at the bottom), plus
# polygon/polygonfilled (Phase 15) - the one command beyond §10's original set.
# `graphics` is a control now (Phase 13); commands are dotted method calls on it.

window "Turtle Full Tour", 500, 500:
    graphics as canvas1 at 0, 0, 500, 500
    canvas1.backcolor("lightyellow")
    canvas1.pen("black")
    canvas1.size(2)

    # A square, using go/turn (heading 0 is north, turning is clockwise).
    canvas1.down()
    canvas1.go(100)
    canvas1.turn(90)
    canvas1.go(100)
    canvas1.turn(90)
    canvas1.go(100)
    canvas1.turn(90)
    canvas1.go(100)
    canvas1.turn(90)
    canvas1.up()

    # place jumps to a position without ever drawing, regardless of pen state.
    canvas1.place(250, 100)

    # circlefilled/circle are centered on the current position.
    canvas1.fill("seagreen")
    canvas1.circlefilled(30)

    canvas1.goto(340, 100)
    canvas1.pen("navy")
    canvas1.circle(30)

    # box/boxfilled measure a width/height from the current position as
    # their top-left corner.
    canvas1.place(100, 250)
    canvas1.pen("black")
    canvas1.fill("orange")
    canvas1.boxfilled(80, 50)

    canvas1.place(220, 250)
    canvas1.box(80, 50)

    # ellipse/ellipsefilled are centered on the current position too.
    canvas1.place(380, 275)
    canvas1.fill("purple")
    canvas1.ellipsefilled(60, 30)

    canvas1.place(380, 340)
    canvas1.ellipse(60, 30)

    # text, with a chosen font (family, or family + point size).
    canvas1.place(60, 400)
    canvas1.font("Arial", 16)
    canvas1.text("Leopard turtle graphics")

    # polygon/polygonfilled draw a regular n-sided shape (n >= 3) centered on
    # the current position, first corner in the current heading's direction.
    canvas1.place(60, 80)
    canvas1.pen("black")
    canvas1.fill("crimson")
    canvas1.polygonfilled(3, 35)

    canvas1.place(440, 420)
    canvas1.pen("darkgreen")
    canvas1.polygon(6, 35)

    # canvas1.drawbmp("some_image.png", 20, 20)   -- draws an image file at a position

    # home resets both position and heading; north resets only the heading.
    canvas1.home()
    canvas1.north()
