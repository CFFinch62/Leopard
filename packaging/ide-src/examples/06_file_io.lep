# Lesson 06 - File I/O
#
# write_file/append_file/read_file/delete_file/make_dir/remove_dir/file_exists
# all work from a bare (no-window) script - none of them need a GUI. Results
# are printed to the console; 06_scratch.txt/06_scratch_dir are just scratch
# paths this lesson creates and cleans up along the way.

write_file("06_scratch.txt", "first line\n")
append_file("06_scratch.txt", "second line\n")

contents = read_file("06_scratch.txt")
print "06_scratch.txt contains:"
print contents

print "file_exists(\"06_scratch.txt\"): " & str(file_exists("06_scratch.txt"))
print "file_exists(\"nope.txt\"): " & str(file_exists("nope.txt"))

make_dir("06_scratch_dir")
print "created 06_scratch_dir"

delete_file("06_scratch.txt")
print "file_exists after delete_file: " & str(file_exists("06_scratch.txt"))

remove_dir("06_scratch_dir")
print "removed 06_scratch_dir (remove_dir only removes empty directories)"
