# Dialogs - notice/confirm/ask, plus the file/color/font pickers.

window "Dialogs", 420, 260:

    label "Dialogs and file/color/font pickers" as introLabel at 10, 10, 380, 20
    button "Say hello" as noticeButton at 10, 40, 150, 24
    button "Ask a question" as confirmButton at 10, 74, 150, 24
    button "Ask for input" as askButton at 10, 108, 150, 24
    button "Pick a file" as fileButton at 10, 142, 150, 24
    button "Pick a color" as colorButton at 170, 142, 150, 24
    button "Pick a font" as fontButton at 10, 176, 150, 24
    label "" as resultLabel at 10, 210, 390, 40

    on click noticeButton:
        notice("Hello from Leopard!")

    on click confirmButton:
        if confirm("Do you like Leopard?"):
            resultLabel.text = "Great, glad you like it!"
        else:
            resultLabel.text = "Fair enough."

    on click askButton:
        answer = ask("What's your name?")
        if answer = "":
            resultLabel.text = "No name entered."
        else:
            resultLabel.text = "Hello, " & answer & "!"

    on click fileButton:
        path = open_file_dialog()
        resultLabel.text = "Chosen file: " & path

    on click colorButton:
        chosen = color_dialog()
        if chosen <> "":
            resultLabel.background = chosen
            resultLabel.text = "Background set to " & chosen

    on click fontButton:
        family = font_dialog()
        if family <> "":
            resultLabel.font = family
            resultLabel.text = "Font set to " & family
