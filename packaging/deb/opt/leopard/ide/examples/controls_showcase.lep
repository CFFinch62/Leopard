# Controls showcase - every control kind, most properties, most events.
# Nothing here needs a "correct" outcome to click through - explore freely.

window "Controls Showcase", 640, 480:

    label "Text controls:" as textSectionLabel at 10, 10, 200, 20
    textbox as nameBox at 10, 34, 200, 24
    textedit as notesBox at 10, 64, 300, 80

    label "Click count: 0" as clickLabel at 10, 154, 200, 20
    button "Click me" as clickButton at 220, 34, 100, 24
    bmpbutton "leopard_icon.svg" as iconButton at 330, 34, 40, 40

    label "Selection controls:" as selectSectionLabel at 10, 184, 200, 20
    listbox as fruitList at 10, 208, 150, 100
    combobox as colorCombo at 170, 208, 150, 24
    label "Selected: (none)" as selectionLabel at 10, 314, 300, 20

    label "Toggle controls:" as toggleSectionLabel at 10, 344, 200, 20
    groupbox "Grouped options" as optionsGroup at 210, 344, 200, 90
    checkbox "Enable notes box" as enableCheck at 10, 368, 200, 24
    radiobutton "Option A" as optionA at 220, 368, 150, 24
    radiobutton "Option B" as optionB at 220, 392, 150, 24

    clicks = 0
    fruitList.items = ["Apple", "Banana", "Cherry"]
    colorCombo.items = ["red", "green", "blue"]
    enableCheck.checked = true

    on click clickButton:
        clicks = clicks + 1
        clickLabel.text = "Click count: " & str(clicks)
        nameBox.color = "darkblue"

    on click iconButton:
        notesBox.text = notesBox.text & "Icon button clicked.\n"

    on select fruitList:
        selectionLabel.text = "Selected: " & fruitList.items[fruitList.selected]

    on change colorCombo:
        notesBox.background = colorCombo.items[colorCombo.selected]

    on change enableCheck:
        notesBox.enabled = enableCheck.checked

    on change optionA:
        if optionA.checked:
            notesBox.text = notesBox.text & "Option A selected.\n"

    on change optionB:
        if optionB.checked:
            notesBox.text = notesBox.text & "Option B selected.\n"

    on close:
        write_file("controls_showcase_output.txt", "Session ended with " & str(clicks) & " click(s).\n")
