#!/usr/bin/env python3
import os
import pathlib
import sys

root = pathlib.Path('/opt/leopard/ide')
if root.exists():
    sys.path.insert(0, str(root))

lang_root = pathlib.Path('/opt/leopard/lang/src')
if lang_root.exists():
    sys.path.insert(0, str(lang_root))

os.environ.setdefault('PYTHONPATH', '/opt/leopard/ide:/opt/leopard/lang/src')

if __name__ == '__main__':
    from main import main
    sys.exit(main())
